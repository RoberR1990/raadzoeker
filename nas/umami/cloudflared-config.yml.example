# Kopieer naar /volume1/docker/umami/tunnel/config.yml (naast <TUNNEL-ID>.json) en vul de tunnel-id in.
# Alleen de twee paden die de tracker nodig heeft gaan naar buiten; al het andere krijgt 404.
tunnel: <TUNNEL-ID>
credentials-file: /etc/cloudflared/<TUNNEL-ID>.json
ingress:
  - hostname: stats.raadzoeker.nl
    path: ^/(script\.js|api/send)$
    service: http://umami:3000
  - service: http_status:404
